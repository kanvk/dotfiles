#!/usr/bin/env bash
set -euo pipefail
{{ template "brew-path-bootstrap" . }}

action="${1:-doctor}"
if (( $# )); then shift; fi
case "$action" in
    bootstrap|deploy|doctor) ;;
    *) printf 'Unknown Herdr action: %s\n' "$action" >&2; exit 2 ;;
esac
if [[ {{ get . "is_wsl" | default false | toString | shellQuote }} != true ]]; then
    printf '%s\n' 'Herdr configuration commands require WSL.' >&2
    exit 1
fi
checkout="${HERDR_CONFIG_DIR:-$HOME/p/herdr-config}"
case "$checkout" in
    '~/'*) checkout="$HOME/${checkout#\~/}" ;;
esac
if [[ ! -f "$checkout/scripts/deploy.py" ]]; then
    printf 'Herdr config checkout missing at %s. Clone it there or set HERDR_CONFIG_DIR.\n' "$checkout" >&2
    exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' 'Herdr configuration requires Python 3.11 or newer.' >&2
    exit 1
fi
arguments=("$action")
if [[ "$action" == bootstrap ]]; then
    source_dir={{ .chezmoi.sourceDir | shellQuote }}
    arguments+=(--settings-dir "$source_dir/dot_config/windows")
fi
exec python3 "$checkout/scripts/deploy.py" "${arguments[@]}" "$@"
